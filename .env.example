# =========================================================
# Database
# =========================================================
#
# PostgreSQL 17 + PostGIS. Both the application
# (app/database/session.py) and Alembic (alembic/env.py) read this single
# variable — there are no separate POSTGRES_* variables.
#
# Postgres.app on macOS commonly serves on 5433 rather than 5432.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nrw_dc_bi


# =========================================================
# OpenAI
# =========================================================
#
# Used by the AI Advisor panel (including Agentic RAG news questions),
# and by the two opt-in pipeline steps `news-embed` and `news-signals`.
# The rest of the dashboard runs without it — NewsRetrievalService
# degrades to returning no results rather than raising when this is
# unset, so the AI Advisor still answers, just without cited news.

OPENAI_API_KEY=

# Mini model for plan/verify/translate/extract steps. Defaults to
# gpt-4.1-mini if unset.
# OPENAI_MODEL=gpt-4.1-mini

# Used only for the Agentic RAG final answer, where more capability is
# worth the extra cost. Defaults to gpt-4.1 if unset.
# OPENAI_ANSWER_MODEL=gpt-4.1

# Must stay a 1536-dimension model to match the news_articles.embedding
# column. Defaults to text-embedding-3-small if unset.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
