# =========================================================
# Database
# =========================================================
#
# PostgreSQL 17 + PostGIS. Both the application
# (app/database/session.py) and Alembic (alembic/env.py) read this single
# variable — there are no separate POSTGRES_* variables.
#
# Postgres.app on macOS commonly serves on 5433 rather than 5432.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nrw_dc_bi


# =========================================================
# OpenAI
# =========================================================
#
# Used by the AI Advisor panel only. The rest of the dashboard runs
# without it.

OPENAI_API_KEY=


# =========================================================
# TransnetBW Project Radar harvester (IRIS-SIG-30)
# =========================================================
#
# Targets PostgreSQL 16 / PostGIS 3.4, started with
# `docker compose up -d postgis16` (host port 5434). See TRANSNETBW.md.
#
# The container's superuser password. Pick your own; there is no default.

STAGING_POSTGRES_PASSWORD=

# Where the harvester writes iris_staging.*. Falls back to DATABASE_URL
# when unset. Live and fixture (--offline) runs refuse to share a database,
# so point offline demos at a different database name.

TRANSNETBW_DATABASE_URL=postgresql://postgres:<STAGING_POSTGRES_PASSWORD>@localhost:5434/iris_signals

# Optional overrides — the defaults are shown.
#
# TRANSNETBW_REQUEST_DELAY_S=1.5
# TRANSNETBW_TIMEOUT_S=30
# TRANSNETBW_MAX_RETRIES=3
# TRANSNETBW_USER_AGENT=IRIS-ProjectRadar/0.1 (+https://github.com/Rahul-Bijarniya-1/iris-sample-assignment)
# TRANSNETBW_SINCE=2020-01-01
# TRANSNETBW_RETIRE_AFTER_MISSES=2
# TRANSNETBW_GATE_MIN_LISTING_CARDS=15
# TRANSNETBW_GATE_MAX_FETCH_FAILURE_RATIO=0.30
# TRANSNETBW_GATE_MIN_RESOLVED=1
# TRANSNETBW_GATE_MAX_DISCOVERY_GAP=5
# TRANSNETBW_ENABLE_NOMINATIM=false
